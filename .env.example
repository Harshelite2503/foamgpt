# Copy to .env and fill in
ANTHROPIC_API_KEY=sk-ant-...   # alias accepted: MATERIALS_API_KEY
ANTHROPIC_WORKSPACE_ID=   # required only for identity-linked keys (alias: MATERIALS_WORKSPACE_ID)
# Polite-pool email for OpenAlex / Unpaywall (higher rate limits)
OPENALEX_MAILTO=you@example.com   # alias accepted: OPENALEX_MAIL_TO
OPENALEX_API_KEY=   # optional
# Model used for extraction and LLM benchmark
FOAMGPT_MODEL=claude-opus-5
